# Optional shared MCP/HTTP bearer. Empty means unauthenticated access.
#secret
OPENCLAW_MCP_BRIDGE_BEARER=example: openssl rand -hex 32

# Enable JSON notifications and named handlers at /mcp/direct.
#choices: true false
OPENCLAW_MCP_BRIDGE_DIRECT=true

# Also make plain webhook inputs available through new_message.
#choices: true false
OPENCLAW_MCP_BRIDGE_DIRECT_FIFO=false
