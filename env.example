# One existing OpenClaw agent and its MCP bearer per group; use new/skip to repeat.
# Unknown agents and incomplete pairs are skipped. Blank disables the bridge.
#repeat-group: OPENCLAW_MCP_BRIDGE suffix02 OPENCLAW_MCP_BRIDGE_AGENT OPENCLAW_MCP_BRIDGE_BEARER
OPENCLAW_MCP_BRIDGE_AGENT=

#required:
#secret
OPENCLAW_MCP_BRIDGE_BEARER=example: openssl rand -hex 32
