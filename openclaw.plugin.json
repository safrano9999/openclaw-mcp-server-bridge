{
  "id": "openclaw-mcp-server-bridge",
  "name": "OpenClaw MCP Server Bridge",
  "description": "Expose selected agents' admitted channel messages through an authenticated MCP endpoint.",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "agentIds": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$" }, "default": [] },
      "credentials": { "type": "object", "maxProperties": 64, "additionalProperties": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" } },
      "allowedOrigins": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "maxLength": 256 }, "default": [] }
    }
  },
  "uiHints": {
    "agentIds": { "label": "MCP agents", "help": "Existing agent IDs whose ordinary channel turns are handled by MCP." },
    "credentials": { "label": "Managed agent credentials", "sensitive": true, "advanced": true },
    "credentials.*": { "sensitive": true },
    "allowedOrigins": { "label": "Allowed browser origins", "advanced": true }
  }
}
