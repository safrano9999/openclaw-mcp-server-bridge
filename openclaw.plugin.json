{
  "id": "openclaw-mcp-server-bridge",
  "name": "OpenClaw MCP Server Bridge",
  "description": "MCP access, direct notifications and deterministic Python event handlers.",
  "activation": { "onStartup": true },
  "configSchema": {
    "type": "object", "additionalProperties": false,
    "properties": {
      "bearer": { "type": "string", "pattern": "^$|^[A-Za-z0-9_-]{43,128}$", "default": "" },
      "defaultChannel": { "type": "string", "pattern": "^$|^[a-z0-9][a-z0-9_-]{0,63}$", "default": "" },
      "allowedOrigins": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "type": "string", "maxLength": 256 }, "default": [] },
      "direct": { "type": "boolean", "default": false },
      "directFifo": { "type": "boolean", "default": false }
    }
  },
  "uiHints": {
    "bearer": { "label": "Bridge bearer", "sensitive": true },
    "defaultChannel": { "label": "Default agent's preferred channel" },
    "allowedOrigins": { "label": "Allowed browser origins", "advanced": true },
    "direct": { "label": "Direct webhook delivery" },
    "directFifo": { "label": "Also enqueue direct webhooks" }
  }
}
